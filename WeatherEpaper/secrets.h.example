#pragma once
// Copy this file to secrets.h and fill in your own values.
// secrets.h is gitignored - do not commit it.

#define WIFI_SSID     "your-wifi-ssid"
#define WIFI_PASS     "your-wifi-password"

// Ambient Weather Network -> Account -> API Keys (https://ambientweather.net/account)
#define AW_API_KEY    "your-ambient-weather-api-key"
#define AW_APP_KEY    "your-ambient-weather-application-key"
#define AW_MAC        "XX:XX:XX:XX:XX:XX"   // your station's MAC, shown on the AWN dashboard
#define STATION_NAME  "My Station"          // shown in the panel header

// ---- site: where the panel lives (every screen that is location-specific reads these) ----
// Demo values below are downtown Chicago. Replace with your own station's position.
#define SITE_NAME       "Chicago, IL"           // shown in the forecast footer
#define SITE_LATITUDE   41.8781                 // decimal degrees; also used for quake distance,
#define SITE_LONGITUDE  -87.6298                //   NWS alerts and the Open-Meteo air-quality call
// NWS forecast grid: GET https://api.weather.gov/points/<lat>,<lon> and read
// properties.gridId / gridX / gridY, then write them as "ID/X,Y".
#define NWS_GRID        "LOT/76,73"
#define SITE_ZIP        "60606"                 // pollen.com forecast ZIP
// River screen: a USGS gauge site number and the NWS gauge (NWSLI) that carries its flood
// categories: https://water.noaa.gov/gauges/<nwsli> -> Flood Categories (feet).
#define RIVER_NAME      "Des Plaines River"
#define RIVER_USGS_SITE "05533600"              // Des Plaines River near Lemont, IL
#define RIVER_NWSLI     "LEMI2"
#define RIVER_FLOOD_ACTION    9.5f
#define RIVER_FLOOD_MINOR    10.0f               // "flood stage"
#define RIVER_FLOOD_MODERATE 13.0f
#define RIVER_FLOOD_MAJOR    15.0f

// ---- portfolio (the Portfolio screen reads these) ----
// NOTE: use /* block comments */ inside this macro, never //. The preprocessor splices the
// backslash-continuation lines into ONE logical line BEFORE stripping comments, so a single //
// silently swallows every holding after it. It still compiles - you just lose the rest.
//
// 1000 shares of each of five broad index ETFs, with round cost bases chosen to show a
// realistic mix of gains and losses. Replace with your own positions.
#define PORTFOLIO_HOLDINGS \
  {"VTI",  1000.0f, 350000.00f, 0, 0, 0},   /* Vanguard Total Stock Market   */ \
  {"VOO",  1000.0f, 700000.00f, 0, 0, 0},   /* Vanguard S&P 500              */ \
  {"VXUS", 1000.0f,  90000.00f, 0, 0, 0},   /* Vanguard Total International  */ \
  {"BND",  1000.0f,  72000.00f, 0, 0, 0},   /* Vanguard Total Bond Market    */ \
  {"GLD",  1000.0f, 300000.00f, 0, 0, 0}    /* SPDR Gold Shares              */
#define PORTFOLIO_CASH     25000.00f        // settlement / sweep balance
#define PORTFOLIO_TREASURY 10000.00f        // a separate account, shown but NOT in the total
